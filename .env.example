# MDCopilot Blog Intelligence: environment template
# Copy to .env and fill in the values. Never commit .env.
# Docker Compose (env_file) and the app settings loader both read this file.
# Everything runs in Docker; no Python on the host.

# ─── Provider API keys (fill these in) ───────────────────────────────────────
OPENAI_API_KEY=
# The Gemini key must belong to a Google project with billing enabled (paid tier)
GEMINI_API_KEY=
# Optional: when set, anthropic:* entries in the routes below become active
ANTHROPIC_API_KEY=
# Optional but recommended (free): raises the PubMed limit from 3 to 10 requests/second
NCBI_API_KEY=
NCBI_CONTACT_EMAIL=

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
# Durable workflows resume only on the same APP_VERSION. Bump it whenever workflow steps
# are added, removed or reordered, and when upgrading dbos 2.x -> 3.x.
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# Mock mode only: select a fixture overlay under backend/fixtures/mock/scenarios/<name> (empty = defaults)
BLOG_AGENT_MOCK_SCENARIO=
# Random 64-hex-char secret for sessions and CSRF (e.g. openssl rand -hex 32)
SESSION_SECRET=change-me
# Dev runs on http://localhost, so secure cookies are off here. Production must set true.
SESSION_COOKIE_SECURE=false
PUBLIC_APP_URL=http://localhost:8310
# First admin account, created with: docker compose exec api sh -c 'python -m mdcopilot_blog.cli create-admin --email "$BOOTSTRAP_ADMIN_EMAIL" --display-name Owner'
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ─── Database (own Postgres 16 + pgvector container) ─────────────────────────
POSTGRES_DB=mdcopilot_blog
POSTGRES_USER=mdcopilot_blog
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Host ports (bound to 127.0.0.1 only)
DB_HOST_PORT=5440
API_HOST_PORT=8300
WEB_HOST_PORT=8310
FAKE_MDCOPILOT_HOST_PORT=8330
PHOENIX_HOST_PORT=8320

# ─── Safety switches (env-only; the UI cannot change these) ──────────────────
# Kill switch: false pauses schedules and rejects new runs
BLOG_AGENT_ENABLED=true
# true = no real LLM calls, web searches or network publishing (fixtures only).
# Set false once the keys above are filled in.
BLOG_AGENT_MOCK_MODE=true
# Mock mode only: artificial seconds per step, used to test crash/resume
BLOG_AGENT_MOCK_STEP_DELAY_SECONDS=0
# The daily run stays paused until the validation runs are approved
BLOG_AGENT_SCHEDULER_ENABLED=false
# Must stay true; the app refuses to start otherwise (human approval is mandatory)
BLOG_HUMAN_APPROVAL_REQUIRED=true
# Gates NETWORK publishers only (mdcopilot_api). Export and confirm-published always work.
# Automatic publishing does not exist in this release.
BLOG_PUBLISHING_ENABLED=false
# Reserved: the Gemini grounding provider is not built (terms review; see RESEARCH_ARCHITECTURE.md)
BLOG_GEMINI_GROUNDING_ENABLED=false

# ─── Schedule and content defaults (editable later in Settings) ──────────────
BLOG_AGENT_DAILY_RUN_TIME=07:00
BLOG_AGENT_TIMEZONE=Asia/Kolkata
BLOG_AGENT_RESEARCH_WINDOW_DAYS=7
BLOG_AGENT_MIN_SOURCE_COUNT=5
BLOG_AGENT_NOVELTY_THRESHOLD=0.85
BLOG_AGENT_WORD_COUNT_MIN=850
BLOG_AGENT_WORD_COUNT_MAX=1150
BLOG_SITE_URL=https://www.mdcopilot.health
BLOG_DEFAULT_CATEGORY=Healthcare AI

# ─── Model routes: ordered "provider:model" lists, first = primary ───────────
# anthropic:* entries are skipped while ANTHROPIC_API_KEY is empty.
# Per-agent overrides can be saved later in Settings.
BLOG_AGENT_SEARCH_ROUTE=openai:gpt-5.6-luna
BLOG_AGENT_RESEARCH_ROUTE=google:gemini-3.8-flash,openai:gpt-5.6-terra
BLOG_AGENT_IDEATION_ROUTE=google:gemini-3.8-flash,openai:gpt-5.6-terra
BLOG_AGENT_DEEP_RESEARCH_ROUTE=google:gemini-3.8-flash,openai:gpt-5.6-terra
BLOG_AGENT_WRITER_ROUTE=openai:gpt-5.6-sol,google:gemini-3.8-flash,anthropic:claude-sonnet-5
# The fact checker always prefers a vendor different from the one that wrote the draft
BLOG_AGENT_FACT_CHECK_ROUTE=google:gemini-3.8-flash,openai:gpt-5.6-terra,anthropic:claude-sonnet-5
BLOG_AGENT_CLINICAL_ROUTE=openai:gpt-5.6-sol,google:gemini-3.8-flash
BLOG_AGENT_EDITORIAL_ROUTE=openai:gpt-5.6-terra,google:gemini-3.8-flash
BLOG_AGENT_SEO_ROUTE=google:gemini-3.5-flash-lite,openai:gpt-5.6-luna
BLOG_AGENT_EMBEDDING_MODEL=google:gemini-embedding-2
BLOG_AGENT_EMBEDDING_DIMENSIONS=1536
# Concurrent calls per provider (OpenAI, Google, Anthropic) inside one process
BLOG_AGENT_PROVIDER_CONCURRENCY=4
# OpenAI web search: context size and tool-call cap for broad scans (and verification) vs deep research
BLOG_AGENT_SEARCH_CONTEXT_SIZE_BROAD=low
BLOG_AGENT_SEARCH_CONTEXT_SIZE_DEEP=medium
BLOG_AGENT_SEARCH_MAX_TOOL_CALLS_BROAD=1
BLOG_AGENT_SEARCH_MAX_TOOL_CALLS_DEEP=2
# false = prices frozen at the pinned genai-prices data (reproducible costs)
BLOG_AGENT_PRICE_AUTO_UPDATE=false

# ─── Limits and guardrails ───────────────────────────────────────────────────
BLOG_AGENT_MAX_COST_PER_RUN_USD=5.00
BLOG_AGENT_DISCOVERY_TIMEOUT_MINUTES=15
BLOG_AGENT_PRODUCTION_TIMEOUT_MINUTES=30
BLOG_AGENT_MAX_PARALLEL_SEARCHES=6
BLOG_AGENT_MAX_PARALLEL_FETCHES=12
# Contact shown in the crawler User-Agent (URL or email)
BLOG_FETCH_CONTACT=
BLOG_FETCH_CONNECT_TIMEOUT_SECONDS=5
BLOG_FETCH_READ_TIMEOUT_SECONDS=15
BLOG_FETCH_MAX_BYTES=5000000
BLOG_FETCH_MAX_REDIRECTS=5
BLOG_FETCH_PER_HOST_LIMIT=2
BLOG_FETCH_ROBOTS_CACHE_HOURS=24
# Retention: DBOS workflow records and source text snapshots
BLOG_DBOS_RETENTION_DAYS=30
BLOG_SOURCE_SNAPSHOT_RETENTION_DAYS=365

# ─── MDCopilot integration ───────────────────────────────────────────────────
# Read-only novelty sync of already-published posts via the public GET /api/v1/blogs.
# Base URL including /api/v1. Leave empty to disable.
BLOG_MDCOPILOT_PUBLIC_API_URL=
BLOG_MDCOPILOT_SYNC_PAGE_SIZE=50
# Publisher: manual_export (default) | mdcopilot_api (local dev backend only for now) | null
BLOG_PUBLISHER=manual_export
BLOG_PUBLISHER_API_URL=http://host.docker.internal:8000/api/v1
# Development-only login endpoint of the local MDCopilot backend
BLOG_PUBLISHER_LOGIN_PATH=/auth/login
BLOG_PUBLISHER_TIMEOUT_SECONDS=20
# Local-dev MDCopilot admin whose login second factor is disabled by the backend admin setting.
# Production publishing needs a backend service token first.
BLOG_PUBLISHER_LOGIN_ID=
BLOG_PUBLISHER_PASSWORD=
# Public site used to build published_url (<url>/blog/<slug>). Local dev frontend: http://localhost:3000
BLOG_PUBLISHER_PUBLIC_URL=http://localhost:3000

# ─── Observability and notifications (optional) ──────────────────────────────
# Empty = trace export off. With the "observability" compose profile: http://phoenix:6006/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
BLOG_NOTIFY_WEBHOOK_URL=
BLOG_NOTIFY_WEBHOOK_TIMEOUT_SECONDS=5
# Optional OpenAI Costs API reconciliation (off). Needs an OpenAI admin key.
BLOG_COST_RECONCILIATION_ENABLED=false
OPENAI_ADMIN_API_KEY=
