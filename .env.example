# Copy to .env. Keep credentials out of source control.
SESSION_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# OpenAI provides web search; Gemini provides embeddings. Both are needed for generation.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
NCBI_API_KEY=
NCBI_CONTACT_EMAIL=

APP_ENV=development
APP_VERSION=0.1.0
PUBLIC_APP_URL=http://localhost:8310
SESSION_COOKIE_SECURE=false
PUBLIC_PROXY_SCHEME=http
LOG_LEVEL=INFO

# No database settings: docker-compose.yml sets DATABASE_URL to the mdcopilot-backend database.
API_HOST_PORT=8300
WEB_HOST_PORT=8310

# Generation is available on demand. Optional daily generation uses the configured timezone.
BLOG_AGENT_ENABLED=true
BLOG_AGENT_SCHEDULER_ENABLED=false
BLOG_AGENT_DAILY_RUN_TIME=07:00
BLOG_AGENT_TIMEZONE=Asia/Kolkata
BLOG_AGENT_MAX_COST_PER_RUN_USD=5.00
BLOG_AGENT_WORD_COUNT_MIN=850
BLOG_AGENT_WORD_COUNT_MAX=1150
BLOG_SITE_URL=https://www.mdcopilot.health
BLOG_DEFAULT_CATEGORY=Healthcare AI

# Ordered model routes. Providers without a configured key are skipped.
BLOG_AGENT_SEARCH_ROUTE=openai:gpt-5.4-mini
BLOG_AGENT_RESEARCH_ROUTE=google:gemini-3.8-flash,openai:gpt-5.4-mini
BLOG_AGENT_IDEATION_ROUTE=google:gemini-3.5-flash-lite,google:gemini-3.8-flash,openai:gpt-5.4-mini
BLOG_AGENT_DEEP_RESEARCH_ROUTE=google:gemini-3.8-flash,openai:gpt-5.4-mini
BLOG_AGENT_WRITER_ROUTE=openai:gpt-5.4,google:gemini-3.8-flash,anthropic:claude-sonnet-5
BLOG_AGENT_FACT_CHECK_ROUTE=google:gemini-3.8-flash,openai:gpt-5.4-mini,anthropic:claude-sonnet-5
BLOG_AGENT_CLINICAL_ROUTE=google:gemini-3.8-flash,openai:gpt-5.4-mini
BLOG_AGENT_EDITORIAL_ROUTE=google:gemini-3.5-flash-lite,google:gemini-3.8-flash,openai:gpt-5.4-mini
BLOG_AGENT_SEO_ROUTE=google:gemini-3.5-flash-lite,openai:gpt-5.4-mini
BLOG_AGENT_EMBEDDING_MODEL=google:gemini-embedding-2

# Export works without a website integration. Network publishing requires human approval.
BLOG_PUBLISHER=manual_export
BLOG_PUBLISHING_ENABLED=false
BLOG_PUBLISHER_API_URL=http://host.docker.internal:8000/api/v1
BLOG_PUBLISHER_PUBLIC_URL=http://localhost:3000
BLOG_PUBLISHER_LOGIN_ID=
BLOG_PUBLISHER_PASSWORD=

# Optional existing-post import for duplicate detection and internal links.
BLOG_MDCOPILOT_PUBLIC_API_URL=
