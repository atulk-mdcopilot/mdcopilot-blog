# Copy to .env. Keep credentials out of source control.
# docker-compose.yml sets DATABASE_URL, BLOG_INTERNAL_TOKEN, BACKEND_INTERNAL_URL and BACKEND_INTERNAL_TOKEN
# itself (development values); a value for them here would be overridden.

# Provider keys. A route entry whose provider has no key is skipped. OpenAI is required (web search).
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: PubMed lookups work without a key, at a lower rate limit.
NCBI_API_KEY=
NCBI_CONTACT_EMAIL=

APP_ENV=development
# Bump when workflow steps change, so DBOS does not recover old workflows into new code.
APP_VERSION=0.2.0
LOG_LEVEL=INFO

# false = POST /api/blog-agent/runs is refused.
BLOG_AGENT_ENABLED=true
BLOG_AGENT_MAX_COST_PER_RUN_USD=5.00
BLOG_AGENT_WORD_COUNT_MIN=850
BLOG_AGENT_WORD_COUNT_MAX=1150
BLOG_SITE_URL=https://www.mdcopilot.health
BLOG_DEFAULT_CATEGORY=Healthcare AI
BACKEND_TIMEOUT_SECONDS=20

# Ordered model routes, first = primary.
BLOG_AGENT_SEARCH_ROUTE=openai:gpt-5.4-mini
BLOG_AGENT_DEEP_RESEARCH_ROUTE=google:gemini-3.8-flash,openai:gpt-5.4-mini
BLOG_AGENT_WRITER_ROUTE=openai:gpt-5.4,google:gemini-3.8-flash,anthropic:claude-sonnet-5
# Fact-check keeps this order but moves entries from the provider that wrote the draft to the end
# (independent check), so with an OpenAI-written draft the effective order is google, anthropic, openai.
BLOG_AGENT_FACT_CHECK_ROUTE=google:gemini-3.8-flash,openai:gpt-5.4-mini,anthropic:claude-sonnet-5
BLOG_AGENT_CLINICAL_ROUTE=google:gemini-3.8-flash,openai:gpt-5.4-mini
BLOG_AGENT_EDITORIAL_ROUTE=google:gemini-3.5-flash-lite,google:gemini-3.8-flash,openai:gpt-5.4-mini
BLOG_AGENT_SEO_ROUTE=google:gemini-3.5-flash-lite,openai:gpt-5.4-mini

# Every other setting (research window, fetch limits, timeouts, concurrency) has a working default in
# backend/src/mdcopilot_blog/settings.py; set one here only to override it.
